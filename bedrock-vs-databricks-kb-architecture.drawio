        <mxCell id="cost_table" value="&lt;table style=&quot;font-size:10px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#232F3E;color:white;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:15%&quot;&gt;Component&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:28%&quot;&gt;AWS Bedrock + S3 Vectors&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:28%&quot;&gt;AWS Bedrock + OpenSearch&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:29%&quot;&gt;Databricks&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Vector Storage&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;~$0.023/GB (S3 pricing!)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;~$0.24/hr per OCU (min 2)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFEBEE&quot;&gt;Cluster ($0.40-2.00/hr)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Idle Cost&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;$0 (storage only)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;~$350/mo (min OCUs)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFEBEE&quot;&gt;$500-2000/mo (cluster)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Query Cost&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;Pay per query + tokens&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Pay per query + tokens&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;DBU/hr + model serving&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold