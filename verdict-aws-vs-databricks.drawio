<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro CLI" modified="2026-08-18">
  <diagram name="Verdict - AWS vs Databricks" id="verdict">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="VERDICT: AWS Bedrock/AgentCore vs Databricks for Knowledge Base Q&amp;A (20 Complex PDFs)" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="820" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="winner_box" value="WINNER: AWS Bedrock/AgentCore (for this use case)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;fontColor=#ffffff;strokeColor=none;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="48" width="500" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="reason" value="For 20 PDFs (including complex ones): faster to production, lower cost, sufficient capabilities. Databricks justified only for multi-cloud or custom embedding needs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontColor=#1B5E20;strokeColor=#82b366;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="90" width="680" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="grp_score" value="Scorecard: Category-by-Category Winner" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;rounded=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="980" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="scorecard" value="&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#232F3E;color:white;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:22%&quot;&gt;Category&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:10%&quot;&gt;Weight&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:30%&quot;&gt;AWS Bedrock / AgentCore&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:30%&quot;&gt;Databricks (Mosaic AI)&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;width:8%&quot;&gt;Winner&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Time to Production&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;Minutes (upload S3 &amp;rarr; configure &amp;rarr; query)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Hours/Days (build pipeline, deploy endpoint)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Complex Doc Parsing&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;BDA + FM parsers (charts, tables, infographics)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Custom vision pipelines (more effort)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Data Connectors&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;10+ native (S3, Confluence, SharePoint, Salesforce)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;File/table-based only, custom pipelines needed&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Retrieval Quality&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;Hybrid search + reranking + query decomposition&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Same capabilities but requires code&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Guardrails &amp; Safety&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;Built-in (PII, topic, content, hallucination)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Must build custom guardrails&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Citations&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;Built-in source attribution&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Must implement in RAG chain&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Evaluation&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;7 built-in metrics + custom (but no CI/CD loop)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4&quot;&gt;MLflow + CI/CD + A/B + regression testing&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4;font-weight:bold&quot;&gt;DB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Access Control (ACL)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;ACL-aware filtering (syncs from connectors)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4&quot;&gt;Unity Catalog (column-level, org-wide lineage)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4;font-weight:bold&quot;&gt;DB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Fine-tuning&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;LLM only (no embeddings, no RLHF, no Claude)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4&quot;&gt;Full: embeddings + LLM + RLHF/DPO&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4;font-weight:bold&quot;&gt;DB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Cost (20 PDFs)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9&quot;&gt;Near-zero (S3 Vectors + pay-per-query)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;~$0 incremental if cluster exists&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#E8F5E9;font-weight:bold&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Multi-Cloud&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Low-Med&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;AWS only&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4&quot;&gt;AWS, Azure, GCP&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4;font-weight:bold&quot;&gt;DB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;font-weight:bold&quot;&gt;Custom Retrieval Algo&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc&quot;&gt;Fixed (tune params only)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4&quot;&gt;Any algorithm (ColBERT, graph, etc.)&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #ccc;background:#FFF9C4;font-weight:bold&quot;&gt;DB&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f0f0f0;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc&quot;&gt;TOTAL (weighted)&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;background:#E8F5E9;color:#1B5E20&quot;&gt;WINS: 7 categories&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;background:#FFF9C4;color:#F57F17&quot;&gt;WINS: 5 categories&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #ccc;background:#01A88D;color:white&quot;&gt;AWS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;overflow=fill;rounded=1;strokeColor=#cccccc;" vertex="1" parent="grp_score">
          <mxGeometry x="10" y="28" width="960" height="345" as="geometry"/>
        </mxCell>
        <mxCell id="grp_pros_aws" value="AWS Bedrock/AgentCore - PROS" style="swimlane;startSize=22;fillColor=#E8F5E9;strokeColor=#82b366;html=1;rounded=1;fontSize=11;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="20" y="530" width="480" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="pros_aws" value="- Production-ready in minutes (not days)&#xa;- Multimodal parsing: charts/tables/infographics (BDA)&#xa;- 10+ native SaaS connectors with auto-sync + ACL&#xa;- Hybrid search + reranking + query decomposition&#xa;- Guardrails included (PII, topic, hallucination)&#xa;- Citations with source attribution out of the box&#xa;- 7 RAG evaluation metrics + custom metrics&#xa;- S3 Vectors = near-zero cost for 20 PDFs&#xa;- 30+ foundation models (Claude, Nova, Llama, Mistral)&#xa;- AgentCore for multi-step agents with memory/tools&#xa;- Custom chunking via Lambda transformation" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=4;spacingTop=2;" vertex="1" parent="grp_pros_aws">
          <mxGeometry x="5" y="25" width="470" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="grp_cons_aws" value="AWS Bedrock/AgentCore - CONS" style="swimlane;startSize=22;fillColor=#FFEBEE;strokeColor=#EF9A9A;html=1;rounded=1;fontSize=11;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="480" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="cons_aws" value="- Cannot bring custom embedding models (Titan/Cohere only)&#xa;- Cannot fine-tune Claude (best model is frozen)&#xa;- No RLHF/DPO (can't learn from user feedback)&#xa;- No CI/CD-native regression testing for RAG quality&#xa;- Cannot replace core retrieval algorithm (tune only)&#xa;- AWS-only (no multi-cloud portability)&#xa;- No per-query cost tracking (aggregate only)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=4;spacingTop=2;" vertex="1" parent="grp_cons_aws">
          <mxGeometry x="5" y="25" width="470" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="grp_pros_db" value="Databricks - PROS" style="swimlane;startSize=22;fillColor=#FFF9C4;strokeColor=#d6b656;html=1;rounded=1;fontSize=11;fontStyle=1;fontColor=#F57F17;" vertex="1" parent="1">
          <mxGeometry x="520" y="530" width="480" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="pros_db" value="- Full code control over entire RAG pipeline&#xa;- Custom embedding models (fine-tuned BGE/E5/GTE)&#xa;- RLHF/DPO (learn from human feedback)&#xa;- MLflow: A/B testing, regression testing, CI/CD eval&#xa;- Unity Catalog: column-level masking, org-wide lineage&#xa;- Multi-cloud (AWS, Azure, GCP) - no vendor lock-in&#xa;- Any retrieval algorithm (ColBERT, graph-based, etc.)&#xa;- Fine-tune any model (including open-source)&#xa;- Strong data engineering ecosystem (Spark, Delta)&#xa;- Single platform: data + ML + analytics + KB" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=4;spacingTop=2;" vertex="1" parent="grp_pros_db">
          <mxGeometry x="5" y="25" width="470" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="grp_cons_db" value="Databricks - CONS" style="swimlane;startSize=22;fillColor=#FFEBEE;strokeColor=#EF9A9A;html=1;rounded=1;fontSize=11;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="520" y="740" width="480" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="cons_db" value="- Hours/days to production (not minutes)&#xa;- No native SaaS connectors (Confluence/SharePoint)&#xa;- No built-in guardrails (custom implementation required)&#xa;- No built-in citations (must code source attribution)&#xa;- Everything requires engineering effort&#xa;- Cluster cost if no existing Lakehouse workload&#xa;- Steeper learning curve for non-ML engineers" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=4;spacingTop=2;" vertex="1" parent="grp_cons_db">
          <mxGeometry x="5" y="25" width="470" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="grp_decision" value="Decision Framework" style="swimlane;startSize=24;fillColor=#ffffff;strokeColor=#333333;html=1;rounded=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="895" width="980" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="decision_table" value="&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#01A88D;color:white;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:8px;border:1px solid #ccc;width:50%&quot;&gt;Choose AWS Bedrock/AgentCore When...&lt;/td&gt;&lt;td style=&quot;padding:8px;border:1px solid #ccc;width:50%;background:#FF6F00&quot;&gt;Choose Databricks When...&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;border:1px solid #ccc;background:#E8F5E9;vertical-align:top&quot;&gt;&amp;bull; Need production KB in hours, not weeks&lt;br&gt;&amp;bull; Documents are in SaaS tools (Confluence, SharePoint)&lt;br&gt;&amp;bull; Need guardrails + citations out of the box&lt;br&gt;&amp;bull; Base model quality is sufficient (no RLHF needed)&lt;br&gt;&amp;bull; AWS-native organization&lt;br&gt;&amp;bull; Cost-sensitive (pay-per-query, no cluster)&lt;br&gt;&amp;bull; 80%+ accuracy acceptable for initial launch&lt;/td&gt;&lt;td style=&quot;padding:8px;border:1px solid #ccc;background:#FFF9C4;vertical-align:top&quot;&gt;&amp;bull; Need custom embedding models for domain jargon&lt;br&gt;&amp;bull; Must fine-tune with RLHF from user feedback&lt;br&gt;&amp;bull; Need CI/CD regression testing on RAG quality&lt;br&gt;&amp;bull; Multi-cloud requirement (Azure/GCP presence)&lt;br&gt;&amp;bull; Already have Databricks Lakehouse cluster&lt;br&gt;&amp;bull; Need column-level access control (Unity Catalog)&lt;br&gt;&amp;bull; Need custom retrieval algorithms&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;overflow=fill;rounded=1;strokeColor=#cccccc;" vertex="1" parent="grp_decision">
          <mxGeometry x="10" y="28" width="960" height="95" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
